# Application
APP_NAME="ServiceHub Tunisie"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://servicehub.tn
APP_VERSION=1.3.0

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Frontend URL (for CORS)
FRONTEND_URL=https://app.servicehub.tn

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=servicehub
DB_USERNAME=servicehub_user
DB_PASSWORD=

# Session
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Broadcasting & Queue
BROADCAST_CONNECTION=redis
QUEUE_CONNECTION=redis

# Filesystem
FILESYSTEM_DISK=public

# Cache
CACHE_STORE=redis

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@servicehub.tn"
MAIL_FROM_NAME="${APP_NAME}"

# SMS (for phone verification)
SMS_PROVIDER=twilio
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Payment Gateway (PayTech Tunisia)
PAYTECH_API_KEY=
PAYTECH_API_SECRET=
PAYTECH_ENV=prod
PAYTECH_SUCCESS_URL="${FRONTEND_URL}/payment/success"
PAYTECH_CANCEL_URL="${FRONTEND_URL}/payment/cancel"
PAYTECH_IPN_URL="${APP_URL}/api/webhooks/paytech"

# Sentry (Error Monitoring)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_ENVIRONMENT="${APP_ENV}"
SENTRY_RELEASE="${APP_VERSION}"
SENTRY_SEND_DEFAULT_PII=false
SENTRY_BREADCRUMBS_SQL_QUERIES_ENABLED=true
SENTRY_BREADCRUMBS_SQL_BINDINGS_ENABLED=false
SENTRY_SAMPLE_RATE=1.0

# Google Maps API (for geolocation)
GOOGLE_MAPS_API_KEY=

# Firebase (for push notifications)
FIREBASE_CREDENTIALS_PATH=storage/firebase-credentials.json
FIREBASE_DATABASE_URL=

# AWS S3 (for file storage - optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# CORS
SANCTUM_STATEFUL_DOMAINS="${FRONTEND_URL}"

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Vite
VITE_APP_NAME="${APP_NAME}"
